<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.AI_Assistant_Job_Applier.webapp</string>
	<!-- The pages someone is waiting for. As Background, macOS ran it at priority 4 and slowed its
	     disk reads: the Jobs page took 1.5-2.2 s to build, 0.5 s otherwise (21 Oct 2026). -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Volumes/Storage/D Drive /Rep/AI_Assistant_Job_Applier/.venv/bin/python</string>
		<string>-m</string>
		<string>backend.api</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Volumes/Storage/D Drive /Rep/AI_Assistant_Job_Applier/data/webapp.log</string>
	<key>StandardOutPath</key>
	<string>/Volumes/Storage/D Drive /Rep/AI_Assistant_Job_Applier/data/webapp.log</string>
	<key>WorkingDirectory</key>
	<string>/Volumes/Storage/D Drive /Rep/AI_Assistant_Job_Applier</string>
</dict>
</plist>
