# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Needed from Phase 3 onward (resume tailoring). Not used in Phase 1.
ANTHROPIC_API_KEY=

# Optional: override the DB location (defaults to data/jobs.db)
# DATABASE_URL=sqlite:///data/jobs.db

# Contact address advertised in the scraper User-Agent so site owners can
# reach you. Optional but good practice.
SCRAPER_CONTACT_EMAIL=

# Adzuna job search API (free): https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Job feeds with free keys (all optional; each runs once its key is set)
USAJOBS_API_KEY=        # https://developer.usajobs.gov/APIRequest/Index
USAJOBS_EMAIL=          # the email you registered with (defaults to MAIL_ADDRESS)
JOOBLE_API_KEY=         # https://jooble.org/api/about
CAREERJET_AFFID=        # https://www.careerjet.com/partners/
FINDWORK_API_KEY=       # https://findwork.dev/developers/
