# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Needed from Phase 3 onward (resume tailoring). Not used in Phase 1.
ANTHROPIC_API_KEY=

# Optional: override the DB location (defaults to data/jobs.db)
# DATABASE_URL=sqlite:///data/jobs.db

# Contact address advertised in the scraper User-Agent so site owners can
# reach you. Optional but good practice.
SCRAPER_CONTACT_EMAIL=
